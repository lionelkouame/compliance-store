# @name registerIdentityDocumentDuplicate
### Register Identity Document - Duplicate (expect 409)
POST {{apiUrl}}/identity-documents
Content-Type: application/json
Accept: application/ld+json

{
  "type": "Passport",
  "country": "FRA",
  "number": "18AB12345",
  "expiresAt": "2035-01-31"
}

> {%
    client.test("Status code is 409 Conflict", function() {
        client.assert(response.status === 409, "Expected 409 Conflict");
    });
%}

###

# @name registerIdentityDocumentNationalCard
### Register Identity Document - National Card, same number as the passport (expect 201)
POST {{apiUrl}}/identity-documents
Content-Type: application/json
Accept: application/ld+json

{
  "type": "NationalCard",
  "country": "FRA",
  "number": "18AB12345",
  "expiresAt": "2035-01-31"
}

> {%
    client.test("Status code is 201 Created", function() {
        client.assert(response.status === 201, "Expected 201 Created");
    });
    client.test("Response returns the registered national card", function() {
        client.assert(response.body.type === "NationalCard", "Expected type NationalCard");
        client.assert(response.body.country === "FRA", "Expected country FRA");
        client.assert(response.body.number === "18AB12345", "Expected number 18AB12345");
        client.assert(response.body.expiresAt === "2035-01-31", "Expected expiresAt 2035-01-31");
        client.assert(!!response.body.createdAt, "Expected a createdAt");
    });
%}

