# @name registerIdentityDocument
### Register Identity Document
POST {{apiUrl}}/identity-documents
Content-Type: application/json
Accept: application/ld+json
# Authorization: Bearer {{jwtToken}} — disabled for now, no auth implemented yet

{
  "type": "Passport",
  "country": "FRA",
  "number": "18AB12345",
  "expiresAt": "2035-01-31"
}

> {%
    client.test("Status code is 201 Created", function() {
        client.assert(response.status === 201, "Expected 201 Created");
    });
    client.test("Response returns the registered passport", function() {
        client.assert(!!response.body.id, "Expected an id");
        client.assert(response.body.type === "Passport", "Expected type Passport");
        client.assert(response.body.number === "18AB12345", "Expected number 18AB12345");
    });
    client.global.set("identityDocumentId", response.body.id);
%}

###

# @name registerIdentityDocumentMissingFields
### Register Identity Document - Missing Fields (expect 422)
POST {{apiUrl}}/identity-documents
Content-Type: application/json
Accept: application/ld+json

{}

> {%
    client.test("Status code is 422 Unprocessable Entity", function() {
        client.assert(response.status === 422, "Expected 422 Unprocessable Entity");
    });
%}

