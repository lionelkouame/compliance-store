# @name createEuFranceJurisdiction
### Create the French jurisdiction (European Union)
POST {{apiUrl}}/jurisdictions
Content-Type: application/ld+json
Accept: application/ld+json

{
  "code": "JUR-EU-FRA",
  "label": "France (European Union)",
  "region": "EU",
  "country": "FRA",
  "subRegion": null,
  "applicableFrameworks": ["GDPR", "EIDAS_2", "COMMERCIAL_CODE_FR"]
}

###

# @name createUsCaliforniaJurisdiction
### Create the California jurisdiction (United States)
POST {{apiUrl}}/jurisdictions
Content-Type: application/ld+json
Accept: application/ld+json

{
  "code": "JUR-US-CA",
  "label": "California (United States)",
  "region": "NA",
  "country": "USA",
  "subRegion": "CA",
  "applicableFrameworks": ["CCPA"]
}

###

# @name listJurisdictions
### List all jurisdictions
GET {{apiUrl}}/jurisdictions
Accept: application/ld+json

###

# @name listActiveEuropeanJurisdictions
### Filter active European jurisdictions
GET {{apiUrl}}/jurisdictions?region=EU&active=true
Accept: application/ld+json

###

# @name getEuFranceJurisdictionByCode
### Get a jurisdiction by code (JUR-EU-FRA)
GET {{apiUrl}}/jurisdictions/JUR-EU-FRA
Accept: application/ld+json

###

# @name getUnknownJurisdiction
### Get an unknown jurisdiction
GET {{apiUrl}}/jurisdictions/JUR-DOES-NOT-EXIST
Accept: application/ld+json

###

# @name deactivateEuFranceJurisdiction
### Deactivate the French jurisdiction
PATCH {{apiUrl}}/jurisdictions/JUR-EU-FRA
Content-Type: application/json
Accept: application/ld+json

{
  "active": false
}
