### Create a RegulatoryScope for KYC Onboarding (CNI, Passport, Proof of Address)
POST {{apiUrl}}/regulatory-scopes
Content-Type: application/ld+json
Accept: application/ld+json

{
  "code": "KYC_VERIFICATION",
  "label": "Vérification d'identité KYC",
  "description": "Périmètre de conformité pour la vérification d'identité des clients (CNI, Passeport, Justificatif de domicile)",
  "allowedDocumentTypes": ["CNI", "PASSPORT", "JUSTIFICATIF_DOMICILE"],
  "isActive": true
}

> {%
    client.test("Status code is 201 Created", function() {
        client.assert(response.status === 201, "Expected 201 Created");
    });
%}

### List RegulatoryScopes
GET {{apiUrl}}/regulatory-scopes
Accept: application/ld+json

> {%
    client.test("Status code is 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### Get a RegulatoryScope by code (KYC_VERIFICATION)
GET {{apiUrl}}/regulatory-scopes/KYC_VERIFICATION
Accept: application/ld+json

> {%
    client.test("Status code is 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### Get an unknown RegulatoryScope
GET {{apiUrl}}/regulatory-scopes/DOES_NOT_EXIST
Accept: application/ld+json

> {%
    client.test("Status code is 404", function() {
        client.assert(response.status === 404, "Expected 404 Not Found");
    });
%}
