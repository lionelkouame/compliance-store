# @name storeDocument
### Store an encrypted document for a registered holder (run Holders/post.http first: it sets {{holderId}})
POST {{apiUrl}}/documents
Content-Type: multipart/form-data; boundary=ComplianceStoreBoundary
Accept: application/ld+json
Authorization: Bearer {{apiKey}}

--ComplianceStoreBoundary
Content-Disposition: form-data; name="holderId"

{{holderId}}
--ComplianceStoreBoundary
Content-Disposition: form-data; name="file"; filename="passport.png"
Content-Type: image/png

< ../../passport.png
--ComplianceStoreBoundary--

> {%
    client.test("Status code is 201 Created", function() {
        client.assert(response.status === 201, "Expected 201 Created");
    });
    client.global.set("documentId", response.body.id);
%}

###

# @name storeDocumentWithoutHolder
### Store a document without holderId (expect 422)
POST {{apiUrl}}/documents
Content-Type: multipart/form-data; boundary=ComplianceStoreBoundary
Accept: application/ld+json
Authorization: Bearer {{apiKey}}

--ComplianceStoreBoundary
Content-Disposition: form-data; name="file"; filename="passport.png"
Content-Type: image/png

< ../../passport.png
--ComplianceStoreBoundary--

> {%
    client.test("Status code is 422 Unprocessable Entity", function() {
        client.assert(response.status === 422, "Expected 422");
    });
%}
