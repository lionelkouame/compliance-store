# @name storeKycPassportDocument
### Store Sensitive KYC Document - PASSPORT
POST {{apiUrl}}/documents
Content-Type: multipart/form-data; boundary=ComplianceStoreBoundary
Accept: application/ld+json
# Authorization: Bearer {{jwtToken}} — disabled for now, no auth implemented yet

--ComplianceStoreBoundary
Content-Disposition: form-data; name="documentType"

PASSPORT
--ComplianceStoreBoundary
Content-Disposition: form-data; name="ownerId"

usr_123456789
--ComplianceStoreBoundary
Content-Disposition: form-data; name="file"; filename="passport.png"
Content-Type: image/png

< ../../passport.png
--ComplianceStoreBoundary--

###

# @name storeKycProofOfAddressDocument
### Store Sensitive KYC Document - JUSTIFICATIF_DOMICILE (Proof of Address)
POST {{apiUrl}}/documents
Content-Type: multipart/form-data; boundary=ComplianceStoreBoundary
Accept: application/ld+json
# Authorization: Bearer {{jwtToken}} — disabled for now, no auth implemented yet

--ComplianceStoreBoundary
Content-Disposition: form-data; name="documentType"

JUSTIFICATIF_DOMICILE
--ComplianceStoreBoundary
Content-Disposition: form-data; name="ownerId"

usr_kyc_987654321
--ComplianceStoreBoundary
Content-Disposition: form-data; name="file"; filename="passport.png"
Content-Type: image/png

< ../../passport.png
--ComplianceStoreBoundary--
