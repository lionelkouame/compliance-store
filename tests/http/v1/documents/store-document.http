### Store Sensitive KYC Document - CNI (Carte Nationale d'Identité)
POST {{apiUrl}}/documents
Content-Type: application/json
Accept: application/ld+json
Authorization: Bearer {{jwtToken}}

{
  "regulatoryScopeCode": "KYC_VERIFICATION",
  "documentType": "CNI",
  "ownerId": "usr_kyc_987654321",
  "metadata": {
    "country": "FRA",
    "identityNumber": "123456789012",
    "holderName": "Jean Dupont",
    "expirationDate": "2030-12-31",
    "retentionYears": 5
  }
}

> {%
    client.test("Status code is 201 Created", function() {
        client.assert(response.status === 201, "Expected 201 Created");
    });
%}

