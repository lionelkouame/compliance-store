# @name createNaturalPerson
### Creation d'une natural person — cas nominal (expect 201)
POST {{apiUrl}}/natural-persons
Content-Type: application/json
Accept: application/ld+json

{
  "gender": "male",
  "firstName": "Lionel",
  "lastName": "Kouame",
  "birthday": "1990-05-12"
}

> {%
    client.test("Status code is 201 Created", function() {
        client.assert(response.status === 201, "Expected 201 Created");
    });
%}

###

# @name createNaturalPersonMissingFields
### Creation d'une natural person — champs manquants (expect 422)
POST {{apiUrl}}/natural-persons
Content-Type: application/json
Accept: application/ld+json

{}

> {%
    client.test("Status code is 422 Unprocessable Entity", function() {
        client.assert(response.status === 422, "Expected 422 Unprocessable Entity");
    });
%}

