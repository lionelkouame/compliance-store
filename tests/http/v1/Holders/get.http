# @name createHolderForGet
### Pré-requis : on crée un holder (expect 201, ou 409 s'il existe déjà)
POST {{apiUrl}}/holders
Content-Type: application/json
Accept: application/ld+json

{
    "holderName": "Jane Doe",
    "birthDate": "1990-01-01",
    "email": "jane.doe@example.com"
}

###

# @name searchHolderByEmail
### Recherche d'un holder par email — l'email voyage dans le corps, jamais dans l'URL (expect 200)
POST {{apiUrl}}/holders/search
Content-Type: application/json
Accept: application/ld+json

{
    "email": "jane.doe@example.com"
}

> {%
    client.test("Status code is 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK");
    });
    client.global.set("holderId", response.body.holderId);
%}

###

# @name getHolderById
### Lecture d'un holder par identifiant — cas nominal (expect 200)
GET {{apiUrl}}/holders/{{holderId}}
Accept: application/ld+json

> {%
    client.test("Status code is 200 OK", function() {
        client.assert(response.status === 200, "Expected 200 OK");
    });
    client.test("Response exposes the expected fields", function() {
        client.assert(response.body.hasOwnProperty("holderId"), "Missing holderId");
        client.assert(response.body.hasOwnProperty("holderName"), "Missing holderName");
        client.assert(response.body.hasOwnProperty("status"), "Missing status");
    });
%}

###

# @name getHolderByIdNotFound
### Lecture d'un holder inconnu (expect 404)
GET {{apiUrl}}/holders/01a17b0e-e559-7fc6-b4e1-4b96eaa3262c
Accept: application/ld+json

> {%
    client.test("Status code is 404 Not Found", function() {
        client.assert(response.status === 404, "Expected 404 Not Found");
    });
%}

###

# @name searchHolderByEmailNotFound
### Recherche d'un email inconnu (expect 404)
POST {{apiUrl}}/holders/search
Content-Type: application/json
Accept: application/ld+json

{
    "email": "nobody@example.com"
}

> {%
    client.test("Status code is 404 Not Found", function() {
        client.assert(response.status === 404, "Expected 404 Not Found");
    });
%}
