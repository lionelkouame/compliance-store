<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Entity\Holder" table="holder">
        <id name="id" type="holder_id" length="36">
            <generator strategy="NONE"/>
        </id>
        <field name="name" type="holder_name" length="255" column="name"/>
        <field name="birthDate" type="birth_date" column="birth_date"/>
        <field name="status" type="string" enum-type="App\Domain\ValueObject\Holder\HolderStatus" length="20" column="status"/>
        <field name="email" type="email" length="255" column="email"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>
        <field name="consentCollectedAt" type="datetime_immutable" column="consent_collected_at" nullable="true"/>
        <field name="erasureRequestedAt" type="datetime_immutable" column="erasure_requested_at" nullable="true"/>
        <field name="anonymizedAt" type="datetime_immutable" column="anonymized_at" nullable="true"/>
    </entity>
</doctrine-mapping>
