<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Entity\Document" table="document">
        <indexes>
            <index name="idx_document_holder_id" columns="holder_id"/>
        </indexes>

        <id name="id" type="document_id" length="36">
            <generator strategy="NONE"/>
        </id>

        <!-- Reference to the Holder aggregate by identifier, not by association:
             the Holder does not own the collection of its documents, and the
             existence of the holder is enforced by StoreDocumentUseCase. -->
        <field name="holderId" type="holder_id" length="36" column="holder_id"/>
        <field name="fileHash" type="file_hash" length="64" column="file_hash"/>
        <field name="wrappedDataKey" type="wrapped_data_key" column="wrapped_data_key"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>
    </entity>
</doctrine-mapping>
